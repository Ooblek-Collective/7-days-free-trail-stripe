# Copy this file to .env and fill in your own values. Never commit .env.

# Developers -> API keys -> Create restricted key (rk_...), not the full
# secret key. Give it Write access to: Checkout Sessions, Customers,
# Subscriptions, Refunds; Read access to: Invoices.
STRIPE_SECRET_KEY=rk_test_...

# Product catalog -> your $199/month recurring Price -> copy its ID
STRIPE_PRICE_ID=price_...

# Developers -> Webhooks -> your endpoint's signing secret
# (for local dev, use `stripe listen --forward-to localhost:3000/webhook/stripe`
# and copy the whsec_... it prints instead)
STRIPE_WEBHOOK_SECRET=whsec_...

# Base URL Checkout should redirect back to after payment
APP_URL=http://localhost:3000

# Session cookie signing secret - any long random string
SESSION_SECRET=change-me-to-a-long-random-string

PORT=3000

# Overridable for fast local testing, e.g.:
#   TRIAL_LENGTH_MS=15000 FIRST_PERIOD_LENGTH_MS=30000 npm start
# gives a 15s refund window and a 30s first billing cycle so you can watch
# the trial -> pro flip without waiting real days.
TRIAL_LENGTH_MS=604800000
FIRST_PERIOD_LENGTH_MS=3196800000
